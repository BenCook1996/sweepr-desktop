# Copy to .env and fill in. Never commit .env.
PORT=8787
PUBLIC_URL=http://localhost:8787
DATABASE_PATH=./data/sweepr.db

# Generate with: npm run keygen
LICENSE_PRIVATE_KEY_B64=
SWEEPR_LICENSE_PUBKEY=

# Stripe (use test-mode keys while developing)
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# One-time £1.50 price, recurring £9.99/month price, £29.99/6-month price, and £49.99/year price (GBP), created in the Stripe dashboard
STRIPE_PRICE_ACTIVATION=price_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_SIX_MONTH=price_...
STRIPE_PRICE_ANNUAL=price_...
TRIAL_DAYS=7

# Entitlement token lifetime (offline grace) and device limit
TOKEN_TTL_HOURS=72
MAX_DEVICES=3

# Auto-updater manifest settings
LATEST_APP_VERSION=0.1.0
LATEST_APP_SIGNATURE=
LATEST_APP_NOTES="Bug fixes, security hardening, and new cleaning tools."

# Optional Have I Been Pwned API key for email breach checks
HIBP_API_KEY=

# Enables POST /dev/grant to activate an account without Stripe. NEVER enable in production.
DEV_ENDPOINTS=0

# Mobile store links for the smart /download button (leave blank until the apps are live).
# Android falls back to serving public/Sweepr.apk if present; otherwise shows a 'coming soon' page.
PLAY_STORE_URL=
APP_STORE_URL=

# Website Analytics & Interaction Tracking
# Google Analytics 4 (Format: G-XXXXXXXXXX)
GA_MEASUREMENT_ID=
# Meta Pixel (Facebook / Instagram Pixel ID)
META_PIXEL_ID=
# Microsoft Clarity (Free Heatmaps, Clickmaps & Session Replays)
CLARITY_PROJECT_ID=

# SEO & Search Intelligence (CRM > SEO). All optional: site audit, backlink verification and
# crawler/AI-bot logging work with no keys at all.
SEO_SITE_URL=https://sweeprcleaner.com
# Google Search Console: real rankings, clicks, impressions. Property id, e.g. sc-domain:sweeprcleaner.com
GSC_SITE_URL=
# Service-account JSON (raw JSON, base64 of it, or a file path). Add the account email as a user on the GSC property.
GSC_SERVICE_ACCOUNT_JSON=
# Google Cloud API key with "PageSpeed Insights API" and "Chrome UX Report API" enabled.
GOOGLE_API_KEY=
# Free domain-authority scores (0-10): https://keywordseverywhere.com/account/openpagerank
OPEN_PAGERANK_API_KEY=
# DataForSEO v3 API (Phase 3: 0-100 DR, backlink index, competitor link gap, US search volume, KD%, CPC, ETV): https://app.dataforseo.com/api-access
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_LOCATION_CODE=2840
DATAFORSEO_LANGUAGE_CODE=en
