{
  "name": "sweepr-license-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "keygen": "tsx scripts/keygen.ts",
    "seo:product-advisor": "tsx scripts/weekly-product-content-advisor.ts",
    "cloud:automations": "tsx scripts/cloud-automation-runner.ts",
    "test": "tsx --test test/*.test.ts",
    "test:e2e": "tsx --test --test-concurrency=3 test/e2e-*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "hono": "^4.6.0",
    "nodemailer": "^10.5.0",
    "stripe": "^23.0.1",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^6.4.15",
    "typescript": "^5.6.0"
  }
}
