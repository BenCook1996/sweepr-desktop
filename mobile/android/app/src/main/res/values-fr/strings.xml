    <!-- Tips & Tricks -->
    <string name="tips_title">Trucs et astuces</string>
    <string name="tips_heading">Nettoyez votre appareil manuellement</string>
    <string name="tips_subheading">Des gestes rapides pour l\'espace que SWEEPR Cleaner ne peut pas libérer automatiquement.</string>
    <string name="tips_couldnt_open">Impossible d\'ouvrir cet élément sur ce téléphone</string>

    <string name="tip_browser_title">Vider le cache du navigateur</string>
    <string name="tip_browser_subtitle">Accélérez votre navigation</string>
    <string name="tip_browser_step1">Appuyez sur « Paramètres du navigateur » ci-dessous.</string>
    <string name="tip_browser_step2">Choisissez « Stockage et cache » (ou « Stockage »).</string>
    <string name="tip_browser_step3">Appuyez sur « Vider le cache ». N\'appuyez pas sur « Vider l\'espace de stockage », sauf si vous voulez être déconnecté des sites web.</string>
    <string name="tip_browser_action">Paramètres du navigateur</string>

    <string name="tip_apps_title">Supprimer les apps inutilisées</string>
    <string name="tip_apps_subtitle">Désencombrez votre appareil</string>
    <string name="tip_apps_step1">Appuyez sur « Voir mes apps » ci-dessous pour ouvrir la liste complète des applications.</string>
    <string name="tip_apps_step2">Triez par taille ou repérez les apps que vous n\'avez pas ouvertes depuis des mois.</string>
    <string name="tip_apps_step3">Appuyez sur une app, puis sur « Désinstaller ». La plupart des apps peuvent être réinstallées depuis le Play Store à tout moment.</string>
    <string name="tip_apps_action">Voir mes apps</string>

    <string name="tip_trash_title">Videz la corbeille de vos photos</string>
    <string name="tip_trash_subtitle">Récupérez dès maintenant l\'espace des photos supprimées</string>
    <string name="tip_trash_step1">Les photos supprimées par SWEEPR Cleaner vont dans la corbeille du système et occupent encore de l\'espace pendant 30 jours.</string>
    <string name="tip_trash_step2">Ouvrez votre galerie et allez dans Bibliothèque → Corbeille.</string>
    <string name="tip_trash_step3">Appuyez sur « Vider la corbeille » pour libérer cet espace immédiatement.</string>
    <string name="tip_trash_action">Ouvrir la galerie</string>

    <string name="tip_downloads_title">Nettoyer les téléchargements</string>
    <string name="tip_downloads_subtitle">Vieux PDF, APK et pièces jointes s\'accumulent</string>
    <string name="tip_downloads_step1">Appuyez sur « Ouvrir les téléchargements » ci-dessous.</string>
    <string name="tip_downloads_step2">Triez par taille et supprimez les fichiers inutiles – les fichiers d\'installation (.apk) et anciennes pièces jointes peuvent être supprimés sans risque.</string>
    <string name="tip_downloads_action">Ouvrir les téléchargements</string>

    <string name="tip_whatsapp_title">Libérer de l\'espace WhatsApp</string>
    <string name="tip_whatsapp_subtitle">Vidéos transférées et mèmes s\'accumulent</string>
    <string name="tip_whatsapp_step1">Ouvrez WhatsApp → Paramètres → Stockage et données → Gérer le stockage.</string>
    <string name="tip_whatsapp_step2">Commencez par « Plus de 5 Mo » et « Transféré plusieurs fois ».</string>
    <string name="tip_whatsapp_step3">Sélectionnez et supprimez ce dont vous n\'avez pas besoin. Dans chaque discussion, vous pouvez aussi désactiver « Visibilité des médias ».</string>
    <string name="tip_whatsapp_action">Ouvrir WhatsApp</string>

    <string name="tip_caches_title">Vider le cache des apps</string>
    <string name="tip_caches_subtitle">Les apps de réseaux sociaux et de streaming stockent des gigaoctets</string>
    <string name="tip_caches_step1">Appuyez sur « Paramètres de stockage » ci-dessous.</string>
    <string name="tip_caches_step2">Ouvrez « Applications » et triez par taille.</string>
    <string name="tip_caches_step3">Appuyez sur les grosses apps comme TikTok, Instagram, Spotify ou YouTube → Stockage et cache → « Vider le cache ». Votre compte et vos téléchargements sont conservés.</string>
    <string name="tip_caches_action">Paramètres de stockage</string>

    <string name="tip_storage_title">Utiliser le gestionnaire de stockage Android</string>
    <string name="tip_storage_subtitle">Supprimez les photos sauvegardées et les fichiers volumineux</string>
    <string name="tip_storage_step1">Appuyez sur « Gestionnaire de stockage » ci-dessous.</string>
    <string name="tip_storage_step2">Utilisez « Libérer de l\'espace » pour supprimer les photos déjà sauvegardées dans le cloud, les fichiers volumineux et les apps inutilisées.</string>
    <string name="tip_storage_action">Gestionnaire de stockage</string>

