    <!-- Tips & Tricks -->
    <string name="tips_title">Tips &amp; Tricks</string>
    <string name="tips_heading">Manually clean your device</string>
    <string name="tips_subheading">Quick wins for the space SWEEPR Cleaner can\'t clear automatically.</string>
    <string name="tips_couldnt_open">Couldn\'t open that on this phone</string>

    <string name="tip_browser_title">Clear Browser Cache</string>
    <string name="tip_browser_subtitle">Speed up your web browsing</string>
    <string name="tip_browser_step1">Tap \"Open browser settings\" below.</string>
    <string name="tip_browser_step2">Choose \"Storage &amp; cache\" (or \"Storage\").</string>
    <string name="tip_browser_step3">Tap \"Clear cache\". Don\'t tap \"Clear storage\" unless you want to sign out of websites.</string>
    <string name="tip_browser_action">Open browser settings</string>

    <string name="tip_apps_title">Delete Unused Apps</string>
    <string name="tip_apps_subtitle">Declutter your device</string>
    <string name="tip_apps_step1">Tap \"See my apps\" below to open the full app list.</string>
    <string name="tip_apps_step2">Sort by size or look for apps you haven\'t opened in months.</string>
    <string name="tip_apps_step3">Tap an app, then \"Uninstall\". Most apps can be reinstalled from Play Store any time.</string>
    <string name="tip_apps_action">See my apps</string>

    <string name="tip_trash_title">Empty Your Photo Trash</string>
    <string name="tip_trash_subtitle">Get space back from deleted photos now</string>
    <string name="tip_trash_step1">Photos SWEEPR Cleaner removes go to the system trash and still use space for 30 days.</string>
    <string name="tip_trash_step2">Open your gallery app and go to Library → Trash (or Recycle bin).</string>
    <string name="tip_trash_step3">Tap \"Empty trash\" to free that space immediately.</string>
    <string name="tip_trash_action">Open gallery</string>

    <string name="tip_downloads_title">Clean Up Downloads</string>
    <string name="tip_downloads_subtitle">Old PDFs, APKs and attachments add up</string>
    <string name="tip_downloads_step1">Tap \"Open Downloads\" below.</string>
    <string name="tip_downloads_step2">Sort by size and delete files you no longer need – installers (.apk) and old attachments are safe to remove.</string>
    <string name="tip_downloads_action">Open Downloads</string>

    <string name="tip_whatsapp_title">Free Up WhatsApp Storage</string>
    <string name="tip_whatsapp_subtitle">Forwarded videos and memes pile up</string>
    <string name="tip_whatsapp_step1">Open WhatsApp → Settings → Storage and data → Manage storage.</string>
    <string name="tip_whatsapp_step2">Review \"Larger than 5 MB\" and \"Forwarded many times\" first.</string>
    <string name="tip_whatsapp_step3">Select and delete what you don\'t need. In each chat you can also turn off \"Media visibility\".</string>
    <string name="tip_whatsapp_action">Open WhatsApp</string>

    <string name="tip_caches_title">Clear App Caches</string>
    <string name="tip_caches_subtitle">Social and streaming apps cache gigabytes</string>
    <string name="tip_caches_step1">Tap \"Open storage settings\" below.</string>
    <string name="tip_caches_step2">Open \"Apps\" and sort by size.</string>
    <string name="tip_caches_step3">Tap big apps like TikTok, Instagram, Spotify or YouTube → Storage → \"Clear cache\". Your account and downloads stay.</string>
    <string name="tip_caches_action">Open storage settings</string>

    <string name="tip_storage_title">Use Android\'s Storage Manager</string>
    <string name="tip_storage_subtitle">Remove backed-up photos and large files</string>
    <string name="tip_storage_step1">Tap \"Open storage manager\" below.</string>
    <string name="tip_storage_step2">Use \"Free up space\" to remove photos already backed up to the cloud, large files and unused apps.</string>
    <string name="tip_storage_action">Open storage manager</string>

