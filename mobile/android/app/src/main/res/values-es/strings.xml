    <!-- Tips & Tricks -->
    <string name="tips_title">Consejos y trucos</string>
    <string name="tips_heading">Limpia tu dispositivo manualmente</string>
    <string name="tips_subheading">Trucos rápidos para el espacio que Sweepr no puede liberar automáticamente.</string>
    <string name="tips_couldnt_open">No se pudo abrir en este móvil</string>

    <string name="tip_browser_title">Borra la caché del navegador</string>
    <string name="tip_browser_subtitle">Navega más rápido</string>
    <string name="tip_browser_step1">Toca \"Abrir ajustes del navegador\" abajo.</string>
    <string name="tip_browser_step2">Elige \"Almacenamiento y caché\" (o \"Almacenamiento\").</string>
    <string name="tip_browser_step3">Toca \"Borrar caché\". No toques \"Borrar almacenamiento\" salvo que quieras cerrar sesión en los sitios web.</string>
    <string name="tip_browser_action">Abrir ajustes del navegador</string>

    <string name="tip_apps_title">Elimina apps que no usas</string>
    <string name="tip_apps_subtitle">Despeja tu dispositivo</string>
    <string name="tip_apps_step1">Toca \"Ver mis apps\" abajo para abrir la lista completa de aplicaciones.</string>
    <string name="tip_apps_step2">Ordénalas por tamaño o busca apps que no abres desde hace meses.</string>
    <string name="tip_apps_step3">Toca una app y luego \"Desinstalar\". La mayoría se pueden volver a instalar desde Play Store cuando quieras.</string>
    <string name="tip_apps_action">Ver mis apps</string>

    <string name="tip_trash_title">Vacía la papelera de fotos</string>
    <string name="tip_trash_subtitle">Recupera ya el espacio de las fotos borradas</string>
    <string name="tip_trash_step1">Las fotos que elimina Sweepr van a la papelera del sistema y siguen ocupando espacio durante 30 días.</string>
    <string name="tip_trash_step2">Abre tu app de galería y ve a Biblioteca → Papelera.</string>
    <string name="tip_trash_step3">Toca \"Vaciar papelera\" para liberar ese espacio al instante.</string>
    <string name="tip_trash_action">Abrir galería</string>

    <string name="tip_downloads_title">Limpia las descargas</string>
    <string name="tip_downloads_subtitle">PDF, APK y adjuntos antiguos se acumulan</string>
    <string name="tip_downloads_step1">Toca \"Abrir Descargas\" abajo.</string>
    <string name="tip_downloads_step2">Ordena por tamaño y borra lo que ya no necesites – los instaladores (.apk) y los adjuntos antiguos se pueden eliminar sin problema.</string>
    <string name="tip_downloads_action">Abrir Descargas</string>

    <string name="tip_whatsapp_title">Libera espacio en WhatsApp</string>
    <string name="tip_whatsapp_subtitle">Los vídeos reenviados y los memes se acumulan</string>
    <string name="tip_whatsapp_step1">Abre WhatsApp → Ajustes → Almacenamiento y datos → Administrar almacenamiento.</string>
    <string name="tip_whatsapp_step2">Revisa primero \"Más de 5 MB\" y \"Reenviados muchas veces\".</string>
    <string name="tip_whatsapp_step3">Selecciona y borra lo que no necesites. En cada chat también puedes desactivar \"Visibilidad de archivos multimedia\".</string>
    <string name="tip_whatsapp_action">Abrir WhatsApp</string>

    <string name="tip_caches_title">Borra la caché de las apps</string>
    <string name="tip_caches_subtitle">Las apps sociales y de streaming acumulan gigas de caché</string>
    <string name="tip_caches_step1">Toca \"Abrir ajustes de almacenamiento\" abajo.</string>
    <string name="tip_caches_step2">Abre \"Aplicaciones\" y ordénalas por tamaño.</string>
    <string name="tip_caches_step3">Toca apps grandes como TikTok, Instagram, Spotify o YouTube → Almacenamiento → \"Borrar caché\". Tu cuenta y tus descargas se mantienen.</string>
    <string name="tip_caches_action">Abrir ajustes de almacenamiento</string>

    <string name="tip_storage_title">Usa el gestor de almacenamiento de Android</string>
    <string name="tip_storage_subtitle">Elimina fotos con copia de seguridad y archivos grandes</string>
    <string name="tip_storage_step1">Toca \"Abrir gestor de almacenamiento\" abajo.</string>
    <string name="tip_storage_step2">Usa \"Liberar espacio\" para eliminar fotos que ya tienen copia en la nube, archivos grandes y apps que no usas.</string>
    <string name="tip_storage_action">Abrir gestor de almacenamiento</string>
</resources>
