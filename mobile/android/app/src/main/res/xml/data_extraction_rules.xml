<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31) backup / device-transfer rules.
    Only the small user-preferences file (theme + reminders) is backed up. Everything else –
    RevenueCat caches (its SharedPreferences / files), WorkManager & other databases,
    the cache dir with generated log files – is excluded because nothing is listed in <include>.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="sweepr_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="sweepr_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
