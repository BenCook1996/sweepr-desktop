<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31) backup / device-transfer rules.
    Explicitly exclude sensitive auth, preferences, encrypted vault, and restored vault files.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="sweepr_secure_auth.xml" />
        <exclude domain="sharedpref" path="sweepr_prefs.xml" />
        <exclude domain="file" path="cloud_vault" />
        <exclude domain="external" path="Restored" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sweepr_secure_auth.xml" />
        <exclude domain="sharedpref" path="sweepr_prefs.xml" />
        <exclude domain="file" path="cloud_vault" />
        <exclude domain="external" path="Restored" />
    </device-transfer>
</data-extraction-rules>
