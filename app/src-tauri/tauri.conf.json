{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SWEEPRCleaner",
  "version": "0.1.0",
  "identifier": "com.sweepr.cleaner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SWEEPR Cleaner",
        "width": 1020,
        "height": 680,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://sweeprcleaner.com; connect-src ipc: http://ipc.localhost https://ipc.localhost https://sweeprcleaner.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "app", "deb", "rpm", "appimage"],
    "icon": [ "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico" ],
    "publisher": "SWEEPR Cleaner",
    "copyright": "Copyright © 2026 SWEEPR Cleaner. All rights reserved.",
    "shortDescription": "Safe, honest disk cleaner",
    "longDescription": "SWEEPR Cleaner Desktop — Fast, private, intelligent disk and system cleaner for Windows, macOS, and Linux.",
    "category": "Utility",
    "windows": {
      "signCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/sign-windows.ps1 -File \"%1\"",
      "certificateThumbprint": "1800DBEA6FE847D384E549D02CA372C3D45D8B81",
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://ts.ssl.com",
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "wix": {
        "dialogImagePath": "icons/wix-dialog.bmp",
        "bannerPath": "icons/wix-banner.bmp"
      },
      "nsis": {
        "installMode": "currentUser",
        "compression": "none",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "headerImage": "icons/nsis-header.bmp",
        "installerIcon": "icons/icon.ico",
        "template": "installer.nsi"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist",
      "infoPlist": "Info.plist"
    }
  }
}


