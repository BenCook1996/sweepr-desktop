{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SWEEPRCleaner",
  "version": "0.1.0",
  "identifier": "com.sweepr.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SWEEPR Cleaner",
        "width": 1020,
        "height": 680,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "app", "deb", "rpm", "appimage"],
    "icon": [ "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico" ],
    "publisher": "SWEEPR Cleaner",
    "copyright": "Copyright © 2026 SWEEPR Cleaner. All rights reserved.",
    "shortDescription": "Safe, honest disk cleaner",
    "longDescription": "SWEEPR Cleaner Desktop — Fast, private, intelligent PC disk and system cleaner for Windows.",
    "category": "Utility",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "wix": {
        "dialogImagePath": "icons/wix-dialog.bmp",
        "bannerPath": "icons/wix-banner.bmp"
      },
      "nsis": {
        "installMode": "currentUser",
        "compression": "zlib",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "headerImage": "icons/nsis-header.bmp",
        "installerIcon": "icons/icon.ico",
        "template": "installer.nsi"
      }
    },
    "macOS": { "minimumSystemVersion": "11.0", "hardenedRuntime": true }
  }
}


